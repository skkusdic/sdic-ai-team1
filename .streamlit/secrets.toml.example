# Streamlit Cloud > App settings > Secrets 에 아래 내용을 붙여넣으세요.
# 이 파일은 예시용입니다. 실제 키는 절대 커밋하지 마세요.

# ── 필수 ──────────────────────────────────────────────────────────
DART_API_KEY = "여기에_DART_API_키_입력"           # https://opendart.fss.or.kr
ANTHROPIC_API_KEY = "여기에_ANTHROPIC_API_키_입력" # https://console.anthropic.com

# ── 선택 (없으면 기본값 fallback) ────────────────────────────────
ECOS_API_KEY = "여기에_한국은행_ECOS_API_키_입력"  # https://ecos.bok.or.kr — 금리 실시간 조회
NAVER_CLIENT_ID = "여기에_네이버_클라이언트_ID"     # https://developers.naver.com — 뉴스 컨텍스트
NAVER_CLIENT_SECRET = "여기에_네이버_클라이언트_시크릿"
